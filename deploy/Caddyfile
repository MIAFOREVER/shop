{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
    encode zstd gzip

    @www host www.{$SITE_DOMAIN}
    redir @www https://{$SITE_DOMAIN}{uri} permanent

    reverse_proxy wordpress:80 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}
